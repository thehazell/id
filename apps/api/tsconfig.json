{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["bun", "@cloudflare/workers-types"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@db/*": ["./src/db/*"],
      "@lib/*": ["./src/lib/*"],
